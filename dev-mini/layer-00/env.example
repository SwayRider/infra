# ============================================================
# SwayRider Development Environment Configuration
# ============================================================
# This file contains all environment variables needed to run the
# development stack. Copy this file to .env and customize values.
#
# Default values use example.com domains and placeholder passwords.
# Change these for your local setup.
# ============================================================

# ------------------------------------------------------------
# 1. Network & Security
# ------------------------------------------------------------

# Domain routed by HAProxy to this Traefik instance
DEV_DOMAIN=swayrider.example.com

# Uncomment to enable HTTPS via LetsEncrypt (requires a publicly reachable domain on port 80)
# SSL_ENABLED=true

# Traefik LetsEncrypt ACME email (only used when SSL_ENABLED is set)
TRAEFIK_ACME_EMAIL=admin@example.com

# ------------------------------------------------------------
# 2. WireGuard VPN
# ------------------------------------------------------------

# Public IP or hostname of this server — VPN clients connect here
WG_HOST=your.server.ip.or.domain

# Admin password for the wg-easy web UI
WG_PASSWORD=changeme

# Wirguard ports to use on the server
WG_UDP_PORT=51830
WG_TCP_PORT=51821

# ------------------------------------------------------------
# 3. Resource Limits
# ------------------------------------------------------------

# Elasticsearch JVM heap (keep Xms == Xmx; must be less than ES_MEM_LIMIT)
ES_JAVA_OPTS=-Xms4g -Xmx4g
# Container limits: 5g gives ~1g headroom above the 4g heap
ES_MEM_LIMIT=5g
ES_CPU_LIMIT=2

POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=1

REDIS_MEM_LIMIT=384m
REDIS_CPU_LIMIT=0.5

GARAGE_MEM_LIMIT=512m
GARAGE_CPU_LIMIT=1

TRAEFIK_MEM_LIMIT=256m
TRAEFIK_CPU_LIMIT=0.5

WG_MEM_LIMIT=128m
WG_CPU_LIMIT=0.25

# ------------------------------------------------------------
# 4. Data Paths
# ------------------------------------------------------------

# Path to Elasticsearch data directory
# Ensure the directory exists and is writable by uid 1000
ES_DATA_PATH=/path/to/elasticsearch/data

# Path to Elasticsearch snapshots (for backup/restore)
# Ensure the directory exists and is writable by uid 1000
ES_SNAPSHOTS_PATH=/path/to/elasticsearch/snapshots

# Path to Postgres data directory
POSTGRES_DATA_PATH=/path/to/postgres/data

# Garage object store (PMTiles planet releases): data on the big SSD (~140 GB per release, keep 2),
# metadata on a small fast disk. Both writable by root (the image runs as root).
GARAGE_DATA_PATH=/path/to/garage/data
GARAGE_META_PATH=/path/to/garage/meta

# ------------------------------------------------------------
# 5. PostgreSQL Configuration
# ------------------------------------------------------------

# PostgreSQL admin username
# NOTE: Must match value in layer-20/env.example if used
POSTGRES_USER=postgresadmin

# PostgreSQL admin password
# WARNING: Change in production!
POSTGRES_PASSWORD=changeme

# PostgreSQL database name
POSTGRES_DB=swayriderdb

# ------------------------------------------------------------
# 6. Garage object store (S3-compatible, holds the PMTiles planet releases)
# ------------------------------------------------------------
# Never commit real values. Generate secrets with `openssl rand -hex 32`.

# Container image tag
GARAGE_VERSION=v2.3.0

# Cluster secret and admin API token (read by the container via the environment)
GARAGE_RPC_SECRET=changeme-run-openssl-rand-hex-32
GARAGE_ADMIN_TOKEN=changeme-run-openssl-rand-hex-32

# Host side of the S3 API (container port 3900). Loopback by default; set to the WireGuard/LAN IP or
# 0.0.0.0 when data-manager runs on another machine.
GARAGE_S3_BIND=127.0.0.1
GARAGE_S3_PORT=39000

# Bucket and the two access keys that ./garage/init.sh imports.
# Key id = "GK" + 24 hex chars (echo "GK$(openssl rand -hex 12)"), secret = 64 hex chars.
GARAGE_TILES_BUCKET=swayrider-tiles
# read/write: used by the data-manager deploy
GARAGE_RW_ACCESS_KEY_ID=GKchangeme000000000000000000
GARAGE_RW_SECRET_KEY=changeme-run-openssl-rand-hex-32
# read-only: used by tilesservice
GARAGE_RO_ACCESS_KEY_ID=GKchangeme000000000000000001
GARAGE_RO_SECRET_KEY=changeme-run-openssl-rand-hex-32
