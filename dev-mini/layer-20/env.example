# ============================================================
# Layer-20: Application Services Configuration
# ============================================================
# This file contains environment variables for SwayRider
# application services (auth, mail, region, router, search, tiles).
# Copy to .env in this directory.
#
# Default values use example.com domains and placeholder passwords.
# ============================================================

# ------------------------------------------------------------
# 1. Data Paths
# ------------------------------------------------------------

# Path to geodata (OSM PBF files, etc.)
# Must match GEODATA_PATH in layer-10/env.example
GEODATA_PATH=/path/to/geodata

# Path to tiles data (static map tiles)
TILES_DATA_PATH=/path/to/tilesdata

# Path to tiles cache (disk cache for rendered tiles)
TILES_CACHE_PATH=/path/to/tilescache

# ------------------------------------------------------------
# 2. Network & Domain
# ------------------------------------------------------------

# Domain for Traefik routing (must match layer-00)
DEV_DOMAIN=example.com

# ------------------------------------------------------------
# 3. PostgreSQL Configuration
# ------------------------------------------------------------

# NOTE: Values must match layer-00/env.example
POSTGRES_USER=postgresadmin
POSTGRES_PASSWORD=changeme

# ------------------------------------------------------------
# 3. Auth Service Configuration
# ------------------------------------------------------------

# Admin email for auth service
AUTH_ADMIN_EMAIL=admin@example.com

# Admin password (WARNING: Change in production!)
AUTH_ADMIN_PASSWORD=changeme

# Sender email address for transactional emails
AUTH_MAILER_ADDRESS=swayrider@example.com

# Registration mode: "open" (anyone can register) or "invite_only" (admin must
# invite an email address before that user can register).
AUTH_REGISTRATION_MODE=open

# URL of the registration page sent in invitation emails.
# Only used when AUTH_REGISTRATION_MODE=invite_only.
# Set to the public-facing URL that invited users should open to register.
AUTH_REGISTRATION_URL=https://api.example.com/web/register

# ------------------------------------------------------------
# 4. Mail Service Configuration
# ------------------------------------------------------------

# External SMTP server hostname
MAIL_SMTP_HOST=mail.example.com

# SMTP user (for authentication)
MAIL_SMTP_USER=swayrider@example.com

# SMTP password (WARNING: Change in production!)
MAIL_SMTP_PASSWORD=changeme

# ------------------------------------------------------------
# 5. Tiles Service Configuration
# ------------------------------------------------------------

# Enable gzip compression for tile responses
TILESSERVICE_COMPRESSION_ENABLED=true

# In-memory compression cache size (MB)
TILESSERVICE_COMPRESSION_CACHE_SIZE=200

# Enable disk caching for tiles
TILESSERVICE_DISK_CACHE_ENABLED=true

# Maximum number of files in disk cache
TILESSERVICE_DISK_CACHE_MAX_FILES=2000

# Public host name of the tiles service
TILESSERVICE_PUBLIC_HOST_NAME=https://tiles.example.com

# Public port of the tiles service
TILESSERVICE_PUBLIC_PORT=443

# Public path prefix of the tile service
TILESSERVICE_PUBLIC_PATH_PREFIX=/v1/tiles

# ------------------------------------------------------------
# Cookie namespace (authservice)
# ------------------------------------------------------------
# Prefix applied to all cookie names to avoid conflicts with other apps.
# Override only when deploying under a different brand/domain namespace.
COOKIE_NAMESPACE=com.hevanto-it.swayrider
