# ============================================================
# Layer-30: Public Gateway Configuration
# ============================================================
# swayrider-api is the only externally reachable service.
# Copy to .env in this directory.
# ============================================================

# ------------------------------------------------------------
# 1. Network & Domain
# ------------------------------------------------------------

# Domain for Traefik routing (must match layer-00)
DEV_DOMAIN=example.com

# ------------------------------------------------------------
# 2. CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins.
# AllowCredentials is always enabled, so wildcard (*) is not supported.

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# 4. Worker Pool Sizes
# ------------------------------------------------------------

ROUTE_WORKER_COUNT=5
SEARCH_WORKER_COUNT=10

# ------------------------------------------------------------
# 5. Queue Tuning
# ------------------------------------------------------------

# Maximum pending messages before the gateway returns 429
QUEUE_MAX_DEPTH=500

# How long (seconds) completed job results are kept in Redis
RESULT_TTL_SECONDS=300

# ------------------------------------------------------------
# 6. Rate Limits (requests per minute)
# ------------------------------------------------------------

# Login, register, password-reset endpoints (per IP)
RATE_LIMIT_IP_AUTH=10

# Tiles, health, public-keys (per IP)
RATE_LIMIT_IP_PUBLIC=600

# General authenticated endpoints (per user)
RATE_LIMIT_USER_API=300

# Route and search endpoints (per user)
RATE_LIMIT_USER_EXPENSIVE=20

# ------------------------------------------------------------
# 7. Resource Limits
# ------------------------------------------------------------

SWAYRIDER_API_CPU_LIMIT=1
SWAYRIDER_API_MEM_LIMIT=512m

# ------------------------------------------------------------
# 8. Cookie namespace
# ------------------------------------------------------------
# Prefix applied to all cookie names to avoid conflicts with other apps.
# Override only when deploying under a different brand/domain namespace.
COOKIE_NAMESPACE=com.hevanto-it.swayrider
