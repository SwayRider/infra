# ============================================================
# Layer-10: Geocoding Services Configuration
# ============================================================
# This file contains environment variables for Valhalla and Pelias
# geocoding services. Copy to .env in this directory.
#
# Default values use example.com domains and placeholder passwords.
# ============================================================

# ------------------------------------------------------------
# 1. Data Paths
# ------------------------------------------------------------

# Roots of the deployed data classes. data-manager copies immutable releases into <root>/releases/<tag> and
# switches the <root>/current symlink (see ../README.md, "Data deployment"); nothing is mounted before the first deploy.
# Valhalla: <region>/{valhalla_tiles.tar,admin.sqlite,tz_world.sqlite}
VALHALLA_ROOT=/path/to/valhalla

# Pelias: placeholder/data/store.sqlite3 and per region {wof/,interpolation/,pelias.json}
PELIAS_ROOT=/path/to/pelias

# ------------------------------------------------------------
# 2. Valhalla Configuration
# ------------------------------------------------------------

# Number of server threads for Valhalla service
# Adjust based on available CPU cores
VALHALLA_SERVER_THREADS=2
