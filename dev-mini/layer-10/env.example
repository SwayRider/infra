# ============================================================
# Layer-10: Geocoding Services Configuration
# ============================================================
# This file contains environment variables for Valhalla and Pelias
# geocoding services. Copy to .env in this directory.
#
# Default values use example.com domains and placeholder passwords.
# ============================================================

# ------------------------------------------------------------
# 1. Data Paths
# ------------------------------------------------------------

# Path to geodata (OSM PBF files, etc.)
GEODATA_PATH=/path/to/geodata

# Path to Valhalla tile data
# Each region has a subdirectory (e.g., baltics-russia, central-europe)
VALHALLA_DATA_PATH=/path/to/valhalla

# Path to Pelias data (placeholder, libpostal, pip, api)
# Each region has subdirectories for each service type
PELIAS_DATA_PATH=/path/to/pelias

# ------------------------------------------------------------
# 2. Valhalla Configuration
# ------------------------------------------------------------

# Number of server threads for Valhalla service
# Adjust based on available CPU cores
VALHALLA_SERVER_THREADS=2
